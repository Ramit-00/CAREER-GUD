# ==============================================================================
# CAREER-GUD - Environment Configuration Template
# ==============================================================================
# All values are intentionally left blank for security.
# When values are empty, CAREER-GUD gracefully runs in Fallback / In-Memory mode
# with comprehensive seed data for colleges, careers, quizzes, and consultants.
# ==============================================================================

# App URL
NEXT_PUBLIC_APP_URL=
NODE_ENV=development

# Database (PostgreSQL + pgvector ready)
# Leave empty to use internal high-performance in-memory repository
DATABASE_URL=
DIRECT_URL=

# NextAuth Authentication
AUTH_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
ADMIN_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI & LLM Providers (Optional - Leave empty to use intelligent built-in heuristic counselor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# Cloud Storage (Optional - for consultant verification documents)
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Email / SMTP (Optional - skips sending gracefully if empty)
EMAIL_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Cache / Rate Limiting (Optional)
REDIS_URL=
